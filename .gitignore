# --- secrets and per-machine config -----------------------------------------
# config.ini is per-machine: everyone points at a different URL. Only the
# .example is tracked.
config.ini
config.local.ini

# Certificates from TAK data packages. Never commit these.
certs/
*.p12
*.pem
*.key
*.jks
*.keystore
*.zip

# --- node / web -------------------------------------------------------------
node_modules/
web/dist/

# --- local databases ---------------------------------------------------------
# triggers.db is runtime state, not source. It was tracked, and that was going
# to hurt: it is binary so two people editing vocabulary get an unmergeable
# conflict; merely opening it dirties `git status`, so people reflexively
# `git checkout --` it and silently discard terms the team just typed; and a
# committed stale -wal can be REPLAYED against a different generation of the
# .db, which is data loss rather than merge noise.
#
# Nothing is lost by ignoring it. Both layers rebuild from source on first run:
# db.py::init() restores the trigger phrases, and schema.py::migrate() creates
# the vocabulary tables and seeds them from the tracked, diffable
# web/seed_vocab.json.
web/*.db
web/*.db-wal
web/*.db-shm

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- IDE / OS ---------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- model weights ----------------------------------------------------------
# Speech and LLM weights are gigabytes. Phi-4-multimodal int4 alone is 5.1 GB.
# They are downloadable and machine-specific; never let one near a commit.
models/
*.onnx
*.onnx.data
*.onnx_adapter
*.gguf
*.safetensors
*.bin

# --- runtime output ---------------------------------------------------------
# Recorded CoT sessions can get large. Commit one deliberately with `git add -f`
# if it's the demo fallback you actually want to keep.
*.cot
*.log
